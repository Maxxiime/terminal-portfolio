# The provider URL, type and model are configured in config/portfolio.json.
# Only the API key stays in the environment.
# OpenRouter example:
AI_PROVIDER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI example: use api.openai.com and gpt-4o-mini in config/portfolio.json.
# Ollama example: use http://ollama:11434/v1/chat/completions and llama3.2
# in config/portfolio.json, then leave this key empty.

# Port exposed on the host (default: 3012)
PORT=3012

# All non-secret portfolio, Markdown and analytics settings are configured in
# config/portfolio.json.
