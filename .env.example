# Provider configuration. The API key stays server-side in nginx.
# OpenRouter example:
AI_PROVIDER_TYPE=openai-compatible
AI_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
AI_PROVIDER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_PROVIDER_MODEL=openrouter/free

# OpenAI example:
# AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# AI_PROVIDER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_PROVIDER_MODEL=gpt-4o-mini

# Ollama OpenAI-compatible example:
# AI_PROVIDER_URL=http://ollama:11434/v1/chat/completions
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=llama3.2

# Backward-compatible alias for older compose files.
OPENROUTER_API_KEY=

# Port exposed on the host (default: 3012)
PORT=3012

# Optional runtime identity/config overrides. A mounted config/portfolio.json is also supported.
PORTFOLIO_NAME=
PORTFOLIO_FIRST_NAME=
PORTFOLIO_TERMINAL_HOST=

# Markdown source: github, http, or local.
CONTENT_MODE=github
CONTENT_GITHUB_OWNER=
CONTENT_GITHUB_REPO=
CONTENT_GITHUB_REF=main
CONTENT_GITHUB_PATH=content
# CONTENT_HTTP_BASE_URL=https://storage.example.com/portfolio-content
# CONTENT_HTTP_VERSION_URL=https://storage.example.com/portfolio-content/version.txt
# CONTENT_LOCAL_BASE_URL=/data/content
# CONTENT_LOCAL_VERSION_URL=/data/content/.version

# Optional Umami analytics configuration
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
